<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <property name="now" value="current_timestamp" dbms="postgresql"/>
    <property name="floatType" value="float4" dbms="postgresql"/>
    <property name="clobType" value="clob" dbms="postgresql"/>
    <property name="blobType" value="blob" dbms="postgresql"/>
    <property name="uuidType" value="uuid" dbms="postgresql"/>
    <property name="datetimeType" value="datetime" dbms="postgresql"/>

    <include file="db/changelog/table/user.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/table/tag.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/table/project.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/table/comment.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/table/type.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/table/notification.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/table/project-tag.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/table/project-notification.xml" relativeToChangelogFile="false"/>

    <include file="db/changelog/changes/001-change-notifications.xml" relativeToChangelogFile="false"/>

</databaseChangeLog>
