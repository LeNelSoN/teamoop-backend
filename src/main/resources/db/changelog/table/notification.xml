<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="notification-seq" author="guillaumesubra1">
        <createSequence sequenceName="notification_generator" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="notification" author="guillaumesubra1">
        <createTable tableName="notification">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type" type="varchar">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="type"
                                 baseTableName="notification"
                                 constraintName="fk_notification_type"
                                 deferrable="false"
                                 initiallyDeferred="false"
                                 referencedColumnNames="name"
                                 referencedTableName="type"
                                 validate="true"/>
    </changeSet>
</databaseChangeLog>