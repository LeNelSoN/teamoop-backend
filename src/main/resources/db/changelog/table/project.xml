<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="project-seq" author="guillaumesubra1">
        <createSequence sequenceName="project_generator" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="project" author="guillaumesubra1">
        <createTable tableName="project">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user" type="bigint"/>
            <column name="comment" type="bigint"/>
            <column name="owner" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="varchar"/>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp"/>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="user"
                                 baseTableName="project"
                                 constraintName="fk_project_user_id"
                                 deferrable="false"
                                 initiallyDeferred="false"
                                 referencedColumnNames="id"
                                 referencedTableName="user"
                                 validate="true"/>
        <addForeignKeyConstraint baseColumnNames="user"
                                 baseTableName="project"
                                 constraintName="fk_project_owner_id"
                                 deferrable="false"
                                 initiallyDeferred="false"
                                 referencedColumnNames="id"
                                 referencedTableName="user"
                                 validate="true"/>
    </changeSet>
</databaseChangeLog>